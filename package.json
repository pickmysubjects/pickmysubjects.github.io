{
  "name": "pickmysubjects",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Unofficial, student-built subject planner and recommender for University of Melbourne students. Not affiliated with the University.",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "dev": "npm run data && vite",
    "local": "npm run data && VITE_FORCE_GLASS=1 vite build --outDir .local-site && vite preview --outDir .local-site --port 4300 --strictPort",
    "build": "npm run data && vue-tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "npm run data && vitest run",
    "test:fast": "vitest run --exclude 'tests/stress/**'",
    "typecheck": "vue-tsc --noEmit",
    "paste": "tsx scripts/paste-handbook.ts",
    "import-batch": "tsx scripts/import-batch.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "audit": "tsx scripts/audit-data.ts",
    "snapshot-year": "tsx scripts/snapshot-year.ts",
    "changes": "tsx scripts/changes.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12",
    "yaml": "^2.9.1"
  }
}
