{
  "name": "PickMySubjects",
  "short_name": "PickMySubjects",
  "description": "Free, unofficial subject guide and degree planner for University of Melbourne students: your semester week, subject reviews, suggestions and a checked plan for your whole degree. No account; what you've saved works offline.",
  "id": "/",
  "start_url": "/",
  "lang": "en",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbf6fb",
  "theme_color": "#fbeaf3",
