#!/bin/sh
# Refuse to push commits whose author/committer email is not a GitHub noreply
# address, so a personal email can never leak into this public repo.
# Enable once per clone:  git config core.hooksPath .githooks
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %ae %ce' "$range" | awk '$2 !~ /@users\.noreply\.github\.com$/ || $3 !~ /@users\.noreply\.github\.com$/')
  if [ -n "$bad" ]; then
    echo "pre-push: blocked — these commits use a non-noreply email:" >&2
    echo "$bad" >&2
    echo "Fix: git config user.email <id>+<user>@users.noreply.github.com, then rewrite the commits." >&2
    status=1
  fi
  # Personal addresses and private sheet links must not appear in what's pushed either.
  # (Only lines being added are checked, so the docs that describe the rule don't trip it.)
  leaks=$(git log -p --format= "$range" | grep -E '^\+' | grep -E -i '@gmail\.com|docs\.google\.com/spreadsheets/d/' | head -5)
  if [ -n "$leaks" ]; then
    echo "pre-push: blocked — the changes contain a personal email or a private sheet link:" >&2
    echo "$leaks" >&2
    status=1
  fi
  # Annotated tags carry their own email.
  tagger=$(git for-each-ref --format='%(taggeremail)' "$local_ref" 2>/dev/null | grep -v -E 'users\.noreply\.github\.com|^$')
  if [ -n "$tagger" ]; then
    echo "pre-push: blocked — tag $local_ref uses a non-noreply email." >&2
    status=1
  fi
done
exit $status
